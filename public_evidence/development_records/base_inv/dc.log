# Experimental DC synthesis driver (development only).
# Env: EXP_RTL, EXP_OUT, EXP_PERIOD_PS, EXP_RECIPE (tcl file sourced after constraints)
if {[catch {
set TECH /mnt/mydata/.fft64/tech/99619e6e51b75f151556
set DBLIST [list $TECH/db/comb_rvt_tt.db $TECH/db/seq_rvt_tt.db]
set_app_var target_library $DBLIST
set_app_var link_library [concat [list *] $DBLIST]
set_host_options -max_cores 1
set OUT $::env(EXP_OUT)
file mkdir $OUT
define_design_lib WORK -path [file join $OUT dc_work]
analyze -format sverilog $::env(EXP_RTL)
elaborate fft64_top
current_design fft64_top
link
uniquify
set P $::env(EXP_PERIOD_PS)
create_clock -name clk -period $P [get_ports clk]
set_clock_uncertainty -setup 100 [get_clocks clk]
set_clock_transition 20 [get_clocks clk]
set_input_delay 0 -clock clk [get_ports {rst in_valid frame_start in_re* in_im*}]
set_input_transition 20 [get_ports {rst in_valid frame_start in_re* in_im*}]
set_output_delay 0 -clock clk [all_outputs]
set_load 1 [all_outputs]
set_false_path -from [get_ports rst]
source $::env(EXP_RECIPE)
current_design fft64_top
redirect [file join $OUT area_hier.rpt] {report_area -hierarchy}
ungroup -all -flatten
change_names -rules verilog -hierarchy
redirect [file join $OUT area.rpt] {report_area}
redirect [file join $OUT timing.rpt] {report_timing -delay_type max -max_paths 3 -nets -transition_time}
redirect [file join $OUT ref.rpt] {report_reference}
write -format verilog -hierarchy -output [file join $OUT mapped.v]
} err]} {
  puts stderr "EXP_FATAL: $err"
  exit 1
}
